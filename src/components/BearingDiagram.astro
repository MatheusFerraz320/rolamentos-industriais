---
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props

const ballCount = 10
const ballRadius = 118
const balls = Array.from({ length: ballCount }, (_, i) => {
  const angle = (360 / ballCount) * i
  const rad = (angle * Math.PI) / 180
  return {
    cx: 200 + ballRadius * Math.cos(rad),
    cy: 200 + ballRadius * Math.sin(rad),
  }
})

const majorTicks = Array.from({ length: 24 }, (_, i) => i * 15)
const minorTicks = Array.from({ length: 48 }, (_, i) => i * 7.5).filter((a) => a % 15 !== 0)
---

<svg
  viewBox="0 0 400 400"
  class={className}
  role="img"
  aria-label="Ilustração técnica de um rolamento de esferas em corte"
>
  <g stroke="currentColor" class="text-white/40">
    {minorTicks.map((angle) => (
      <line
        x1="200"
        y1="14"
        x2="200"
        y2="22"
        stroke-width="1.5"
        transform={`rotate(${angle} 200 200)`}
      />
    ))}
    {majorTicks.map((angle) => (
      <line
        x1="200"
        y1="8"
        x2="200"
        y2="24"
        stroke-width="2"
        transform={`rotate(${angle} 200 200)`}
      />
    ))}
  </g>

  <circle
    cx="200"
    cy="200"
    r="150"
    fill="none"
    stroke="currentColor"
    class="text-primary-dark-800"
    stroke-width="15"
  />
  <circle
    cx="200"
    cy="200"
    r="150"
    fill="none"
    stroke="currentColor"
    class="text-primary-dark-900"
    stroke-width="15"
    stroke-opacity="0.18"
  />

  <g class="bearing-spin" style="transform-origin: 200px 200px;">
    <circle
      cx="200"
      cy="200"
      r="118"
      fill="none"
      stroke="currentColor"
      class="text-white/50"
      stroke-width="1.5"
      stroke-dasharray="3 7"
    />

    {balls.map((ball) => (
      <circle
        cx={ball.cx}
        cy={ball.cy}
        r="15.5"
        fill="currentColor"
        class="text-accent-orange"
        stroke="currentColor"
        stroke-width="1"
      />
    ))}

    <circle
      cx="200"
      cy="200"
      r="62"
      fill="none"
      stroke="currentColor"
      class="text-primary-dark-800"
      stroke-width="15"
    />
  </g>

  <circle
    cx="200"
    cy="200"
    r="15"
    fill="currentColor"
    class="text-primary-dark-900"
    stroke="currentColor"
    stroke-width="2"
  />
  <circle cx="200" cy="200" r="2" fill="currentColor" class="text-neutral-light" />

  <g class="text-neutral-light/80">
    <path d="M 306 94 L 330 70" fill="none" stroke="currentColor" stroke-width="1" />
    <text
      x="333"
      y="66"
      font-family="var(--font-mono)"
      font-size="10"
      letter-spacing="0.05em"
      fill="currentColor"
    >
      Ø EXTERNO
    </text>
  </g>

  <g class="text-neutral-light/80">
    <path d="M 296 288 L 320 316" fill="none" stroke="currentColor" stroke-width="1" />
    <text
      x="300"
      y="330"
      font-family="var(--font-mono)"
      font-size="10"
      letter-spacing="0.05em"
      fill="currentColor"
    >
      ESFERAS
    </text>
  </g>

  <g class="text-neutral-light/80">
    <path d="M 155 200 L 118 200" fill="none" stroke="currentColor" stroke-width="1" />
    <text
      x="18"
      y="204"
      font-family="var(--font-mono)"
      font-size="10"
      letter-spacing="0.05em"
      fill="currentColor"
    >
      Ø INTERNO
    </text>
  </g>
</svg>
