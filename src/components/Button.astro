---
import Icon from './Icon.astro'

interface Props {
  href?: string
  variant?: 'primary' | 'outline-light' | 'outline-dark'
  type?: 'button' | 'submit'
  icon?: boolean
  iconName?: 'arrow-right' | 'search'
  iconPosition?: 'left' | 'right'
  class?: string
}

const {
  href,
  variant = 'primary',
  type = 'button',
  icon = true,
  iconName = 'arrow-right',
  iconPosition = 'right',
  class: className = '',
} = Astro.props

const base = `
  inline-flex items-center justify-center gap-2.5
  px-6 py-3.5
  font-mono text-[13px] font-medium uppercase tracking-[0.08em]
  transition-colors duration-200
`

const variants = {
  primary: 'bg-accent-orange text-neutral-light hover:bg-accent-orange-dark',
  'outline-light': 'border border-neutral-light/35 text-neutral-light hover:bg-neutral-light/10',
  'outline-dark': 'border border-ink/25 text-ink hover:bg-ink/5',
}

const classes = `${base} ${variants[variant]} ${className}`

const Tag = href ? 'a' : 'button'
---

<Tag href={href} type={href ? undefined : type} class={classes}>
  {icon && iconPosition === 'left' && <Icon name={iconName} class="size-4 shrink-0" />}
  <span>
    <slot />
  </span>
  {icon && iconPosition === 'right' && <Icon name={iconName} class="size-4 shrink-0" />}
</Tag>
