---
import Button from './Button.astro'
import BearingDiagram from './BearingDiagram.astro'
---

<section class="diagonal-cut-b relative overflow-hidden py-20 pb-28 lg:py-24 lg:pb-32">
  <img
    src="/finalCta.jpg"
    alt="Rolamento industrial em aplicação"
    width="3274"
    height="1312"
    loading="lazy"
    class="absolute inset-0 h-full w-full scale-105 object-cover blur-[3px]"
  />

  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary-dark-900/80 via-primary-dark-900/55 to-primary-dark-800/60"></div>

  <BearingDiagram class="pointer-events-none absolute -right-24 top-1/2 hidden w-[440px] -translate-y-1/2 text-neutral-light opacity-25 lg:block" />

  <div class="relative mx-auto flex max-w-7xl flex-col items-start gap-8 px-6 lg:flex-row lg:items-center lg:justify-between lg:px-10">
    <div class="max-w-xl">
      <h2 class="font-display text-2xl font-semibold uppercase leading-tight text-neutral-light sm:text-3xl">
        Tem uma referência, foto ou aplicação?
      </h2>
      <p class="mt-3 font-sans text-base leading-relaxed text-neutral-light/70">
        Envie as informações do rolamento e solicite uma cotação para sua empresa.
      </p>
    </div>

    <Button href="#cotacao" variant="primary" class="shrink-0">
      Solicitar cotação
    </Button>
  </div>
</section>
