---
import Icon from './Icon.astro'
import Eyebrow from './Eyebrow.astro'

const applications = [
  {
    icon: 'bolt',
    label: 'Motores Elétricos',
    description: 'Rolamentos para aplicações em motores e conjuntos rotativos.',
  },
  {
    icon: 'droplet',
    label: 'Bombas',
    description: 'Aplicações em bombas e sistemas industriais.',
  },
  {
    icon: 'gear',
    label: 'Redutores',
    description: 'Rolamentos para sistemas de transmissão e redução.',
  },
  {
    icon: 'move',
    label: 'Transportadores',
    description: 'Aplicações em sistemas de movimentação e transporte industrial.',
  },
  {
    icon: 'mountain',
    label: 'Britadores e Moinhos',
    description: 'Componentes destinados a aplicações industriais de maior exigência operacional.',
  },
  {
    icon: 'grid',
    label: 'Máquinas Industriais',
    description: 'Rolamentos utilizados em diferentes equipamentos e linhas produtivas.',
  },
  {
    icon: 'crosshair',
    label: 'Máquinas-Ferramenta',
    description: 'Aplicações que demandam precisão e desempenho adequado ao equipamento.',
  },
] as const
---

<section id="aplicacoes" class="bg-neutral-light py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="max-w-2xl">
      <Eyebrow>Aplicações</Eyebrow>
      <h2 class="mt-4 font-display text-3xl font-semibold uppercase text-ink sm:text-4xl">
        Rolamentos para diferentes aplicações industriais
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-ink-soft">
        Componentes destinados à manutenção e reposição em máquinas e equipamentos utilizados em
        diferentes processos industriais.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-px overflow-hidden border border-neutral-gray-200 bg-neutral-gray-200 sm:grid-cols-4">
      {applications.map((app) => (
        <div class="group flex flex-col items-start gap-4 bg-neutral-light p-6 transition-colors hover:bg-neutral-gray-100">
          <Icon
            name={app.icon}
            class="size-7 text-primary-dark-800 transition-colors group-hover:text-accent-orange"
          />
          <div class="flex flex-col gap-1.5">
            <span class="font-sans text-[15px] font-medium text-ink">{app.label}</span>
            <span class="font-sans text-[13px] leading-relaxed text-ink-soft">
              {app.description}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
