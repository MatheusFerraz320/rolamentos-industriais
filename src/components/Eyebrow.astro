---
interface Props {
  tone?: 'light' | 'dark'
  class?: string
}

const { tone = 'dark', class: className = '' } = Astro.props

const toneClasses = tone === 'light' ? 'text-neutral-light/70' : 'text-ink-soft'
---

<span
  class={`
    inline-flex items-center gap-2.5
    font-mono text-[12px] font-medium uppercase tracking-[0.16em]
    ${toneClasses} ${className}
  `}
>
  <span class="h-[6px] w-[6px] bg-accent-orange"></span>
  <slot />
</span>
